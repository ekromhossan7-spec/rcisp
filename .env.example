# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Turso (LibSQL) database credentials. When omitted in local development,
# the app uses a local SQLite file via @libsql/client.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional environment-configured administrator credentials.
# Overrides or supplements database-stored admin accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
